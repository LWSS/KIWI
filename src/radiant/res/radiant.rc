// Entity-display-mode popup (RT_MENU 160, extracted from CoD4Radiant.exe).  In the binary
// OnShowEntities (toolbar 32915) loads this via HandlePopup and TrackPopupMenu's submenu 0;
// each item sets g_PrefsDlg->m_nEntityShowState and re-checks the matching main-menu item
// (SetEntityCheck).  U-RIP deleted the CMenu-based HandlePopup, so this template is KEPT but
// currently unloaded - the raw-HMENU rewrite is unit U-MENU (dispatcher case 32915 = false).
IDR_ENTITYPOPUP160 MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Bounding box",        32909
        MENUITEM "Wireframe",           32916
        MENUITEM "Selected Wireframe",  32911
        MENUITEM "Selected Skinned",    32912
        MENUITEM "Skinned",             32913
        MENUITEM "Skinned and Boxed",   32914
    END
END

// The two other popup targets (the binary's OnPopupRenderMethod 0x4263E0 pushes 0x7C = 124,
// OnPopupSelection 0x4263F0 pushes 0x7D = 125).  Both templates extracted verbatim from the
// PE MENU resources; every id inside them has a command-table entry.  Same U-RIP note as
// above: kept, but unloaded until U-MENU (dispatcher cases 32779 / 32780 = false).
IDR_POPUP_RENDER_METH MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Wireframe",                   32990
        MENUITEM "&Fullbright",                  32991
        MENUITEM "&Normal-based Fake Lighting",  32992
        MENUITEM "&View-based Fake Lighting",    32993
    END
END

IDR_POPUP_SELECTION MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "Select Complete &Tall",  32984
        MENUITEM "Select &Partial Tall",   32983
        MENUITEM "Select T&ouching",       32986
        MENUITEM "Select &Inside",         33008
        MENUITEM "Select T&argetname",     33132
    END
END

// KIWI-UX (ROUND S) - Ctrl+X NO LONGER QUITS THE EDITOR.
// USER DIRECTIVE, verbatim: "Ctrl-X should not quit the app!!!"
//
// It did.  The removed line, which used to be the FIRST entry below, was
//     "X", 32951, VIRTKEY, CONTROL, NOINVERT
// and 32951 is ID_FILE_EXIT_RAD (res/resource.h:34), dispatched at
// mainfrm.cpp:5646 as `case ID_FILE_EXIT_RAD: Radiant_FileExit();`.  So the stock
// binary really does put "quit, now" one slipped key away from Ctrl+C and Ctrl+Z,
// with no confirmation of its own beyond the save prompt.
//
// The ENTRY is removed rather than the id being intercepted, because the id is
// ALSO File->Exit (this file, :46) and that menu item must keep working.  With the
// accelerator gone, Ctrl+X falls through TranslateAccelerator (radiant_main.cpp:651)
// to the editor command map, where the MODERN profile binds it to the clipboard CUT
// (kiwi_keymap.cpp; "KiwiClipCut" = KIWI_CMD_CLIP_CUT 34112).  In the CLASSIC
// profile Ctrl+X is left UNBOUND - "should not quit" read the safe way.
IDR_MAIN_ACCEL ACCELERATORS
BEGIN
    "O", 57601, VIRTKEY, CONTROL, NOINVERT
    "S", 57603, VIRTKEY, CONTROL, NOINVERT
    "L", 33024, VIRTKEY, CONTROL, NOINVERT
    "P", 33025, VIRTKEY, CONTROL, NOINVERT
    "K", 33021, VIRTKEY, CONTROL, NOINVERT
    "M", 33042, VIRTKEY, CONTROL, NOINVERT
    VK_DELETE, 32999, VIRTKEY, CONTROL, NOINVERT
    VK_INSERT, 33000, VIRTKEY, CONTROL, NOINVERT
END



// Brush→Primitives sides dialog. The binary's IDD_ARBITRARY_SIDES (113) template was
// not reconstructed; this minimal one backs the Cylinder/Cone/Sphere commands with the
// single side-count edit field SidesDlgProc (mainfrm.cpp) reads. Faithful behaviour:
// a number-of-sides prompt → Brush_MakeSided{,Cone,Sphere}.
IDD_ARBITRARY_SIDES DIALOGEX 0, 0, 180, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Brush Primitive"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Number of sides:", IDC_STATIC, 12, 14, 70, 12
    EDITTEXT        IDC_ARB_SIDES_IN, 86, 12, 80, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 62, 44, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 120, 44, 52, 15
END










// IDD_PROJECT_SETTINGS (PE resource 0x99 = 153) — File→Project Settings / New Project.
// The binary's ProjectDlgProc (0x495330) fills these five edit controls from the project
// entity on WM_INITDIALOG and writes them back (SetKeyValue + Project_Write) on OK.  Control
// ids are the binary's (1265 basepath / 1274 mapspath / 1253 entitypath / 1260 game / 1273
// basegame).  Layout is a clean functional reconstruction (the binary's exact rects were not
// extracted); the load-bearing part — the five control ids — matches the binary exactly.
IDD_PROJECT_SETTINGS DIALOGEX 0, 0, 280, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Project Settings"
FONT 8, "MS Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "Base path:", IDC_STATIC, 7, 10, 60, 8
    EDITTEXT        1265, 72, 8, 201, 12, ES_AUTOHSCROLL
    LTEXT           "Maps path:", IDC_STATIC, 7, 26, 60, 8
    EDITTEXT        1274, 72, 24, 201, 12, ES_AUTOHSCROLL
    LTEXT           "Entity path:", IDC_STATIC, 7, 42, 60, 8
    EDITTEXT        1253, 72, 40, 201, 12, ES_AUTOHSCROLL
    LTEXT           "Game:", IDC_STATIC, 7, 58, 60, 8
    EDITTEXT        1260, 72, 56, 201, 12, ES_AUTOHSCROLL
    LTEXT           "Base game:", IDC_STATIC, 7, 74, 60, 8
    EDITTEXT        1273, 72, 72, 201, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 165, 104, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 104, 50, 14
END


/////////////////////////////////////////////////////////////////////////////
// String Table — MFC command-prompt / tooltip strings (RT_STRING extracted from
// IW3xRadiant.exe, 2026-07-03).  Format "Status-bar prompt\nTooltip": CFrameWnd's
// default OnToolTipText (TTN_NEEDTEXT) reads these by command id and shows the text
// after '\n' as the toolbar tooltip (CBRS_TOOLTIPS|CBRS_FLYBY are set on m_wndToolBar).
// The port had NO STRINGTABLE, so every toolbar button's tooltip was blank.
//
STRINGTABLE
BEGIN
    57601   "Open an existing map\nOpen"
    57603   "Save the active map\nSave"
    32956   "Flip selected brushes along x-axis\nx-axis Flip"
    32957   "Flip selected brushes along y-axis\ny-axis Flip"
    32958   "Flip selected brushes along z-axis\nz-axis Flip"
    32959   "Rotate selected brushes along x-axis\nx-axis Rotate"
    32960   "Rotate selected brushes along y-axis\ny-axis Rotate"
    32961   "Rotate selected brushes along z-axis\nz-axis Rotate"
