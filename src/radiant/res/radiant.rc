// radiant.rc — CoD4Radiant resource script
// P5.5: the real frame menu (IDR_MENU_QUAKE3) + accelerator (IDR_MAIN_ACCEL),
// reconstructed from the binary's resource table (raw/MENU/214.bin + raw/ACCELERATOR/
// 101.bin, Phase-0 extraction). Numeric command IDs are the binary's; the New/Open/
// Save/Undo/Redo items reuse the MFC standard IDs (0xE100/01/03, 0xE12B/2C) the binary
// used. Menu ids feed radiant_frame.h's Radiant_ExecCommand / the command table.
//
// U-RIP: every DIALOG/DIALOGEX template whose owner was an MFC CDialog/CWnd is DELETED —
// those panels are ImGui now (imgui_panel_*.cpp). The TWO survivors are the raw-Win32
// DialogBoxParamA templates that live code still loads: IDD_PROJECT_SETTINGS (File→Project
// Settings, ProjectDlgProc) and IDD_ARBITRARY_SIDES (Brush→Primitives, SidesDlgProc).
// The icon-toolbar resources (IDR_TOOLBAR152 BITMAP + TOOLBAR, 52 buttons over toolbar.bmp)
// are DELETED too: their only consumer was the deleted CToolBar. res/toolbar.bmp is left on
// disk, now unreferenced — an ImGui toolbar (U-BOOT v2) can re-use the strip.
// The STRINGTABLE stays: it is keyed by command id (usable as ImGui tooltip text) even though
// the CFrameWnd tooltip plumbing that used to read it is gone.

#include "resource.h"
#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"   // was afxres.h (MFC) — winres.h is its Windows-SDK core; the few
                      // MFC-standard command ids the templates use are defined (guarded)
                      // in resource.h.
#undef APSTUDIO_READONLY_SYMBOLS

