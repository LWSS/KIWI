    32986   "Select Touching\nSelect Touching"
    32983   "Select Partial Tall\nSelect Partial Tall"
    33008   "Select Inside\nSelect Inside"
    32783   "Set clipper mode\nClipper"
    32927   "CSG Merge\nCSG Merge"
    32982   "Hollow Selection\nHollow"
    33135   "Flip Texture X\nFlip Texture X"
    33136   "Flip Texture Y\nFlip Texture Y"
    33182   "Rotate Texture 90\nRotate Texture 90"
    33238   "Cycle Edited Texture Layer\nCycle Edited Texture Layer"
    32936   "Toggle camera movement mode\nToggle camera movement mode"
    32781   "Change views\nChange views"
